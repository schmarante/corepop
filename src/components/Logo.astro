---
// Schriftzug „corepop“ im Candy-Look: „core“ und „pop“ zusammengeschrieben, aber in zwei Farben. Das „o“ in „pop“ ist
// der Spreng-Kristall aus dem Spiel – abgerundeter Candy-Würfel, leicht durchscheinend, pulsiert und dreht sich langsam
// (render/logo-gem.js, kleine WebGL-Fläche; ohne WebGL eine CSS-Ersatzform) und hüpft mit dem Wort mit.
// Aufbau pro Buchstabengruppe: Verlauf als Füllung (background-clip: text), Glanzlicht als ::after mit demselben Text,
// Tiefe über gestapelte drop-shadows (die Versätze addieren sich zu einer „Extrusion“). Das Hüpfen sitzt am Wort
// (.logo-word), damit Kristall und Buchstaben zusammen springen. Im Kristall steckt ein unsichtbares „o“ als Text –
// markieren und kopieren ergibt „corepop“, nicht „corepp“. Styles: global.css (.logo).
// Schrift: Sour Gummy (nur hier verwendet – siehe global.css @font-face).
interface Props {
  class?: string;
}
const { class: className = 'text-7xl' } = Astro.props;
---

<span class:list={['logo', className]} aria-label="corepop" role="img">
  <span class="logo-word logo-core" aria-hidden="true"><span class="logo-part" data-text="core">core</span></span><span class="logo-word logo-pop" aria-hidden="true"><span class="logo-part" data-text="p">p</span><span class="logo-gem"><span class="logo-gem-letter">o</span><canvas data-logo-gem class="logo-gem-canvas"></canvas></span><span class="logo-part" data-text="p">p</span></span>
</span>

<script>
  import { startLogoGem } from '../scripts/render/logo-gem.js';

  // je Seitenaufruf neu (ClientRouter), beim Verlassen WebGL freigeben – sonst sammeln sich Kontexte an
  document.addEventListener('astro:page-load', () => {
    const stops = [...document.querySelectorAll<HTMLCanvasElement>('[data-logo-gem]')].map(canvas => startLogoGem(canvas));
    document.addEventListener('astro:before-swap', () => stops.forEach(stop => stop?.()), { once: true });
  });
</script>
