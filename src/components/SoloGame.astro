---
// Spielbildschirm (Vollbild, mobile-first): Kopfzeile · 3D-Bühne · Warteschlange. Logik: src/scripts/modes/solo.js
import { useTranslations, localePath } from '../i18n/index.js';
import { BACK_ICON } from '../scripts/ui/icons.js';
import OptionsButton from './OptionsButton.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/* Die 3D-Bühne liegt über den ganzen Bildschirm, Kopfzeile und Schiffsauswahl schweben darüber – was nach unten
     fliegt, zieht hinter der Auswahl durch statt an einer Kante abgeschnitten zu werden. Körper und Hangar platziert
     die Bühne im freien Bereich dazwischen (data-play). Die Oberfläche lässt Wischen zur Bühne durch
     (pointer-events), nur Buttons fangen Klicks. */}
<div data-solo data-locale={locale} class="relative h-dvh">
  <canvas data-stage class="fade-in absolute inset-0 h-full w-full"></canvas>

  <div class="pointer-events-none relative z-10 flex h-full flex-col">
    {/* Kopfzeile: zurück · Level + Candy-Fortschrittsbalken (Zähler im Balken) · Optionen */}
    <header data-header class="pointer-events-auto flex items-center gap-2 px-2 pt-[max(0.5rem,env(safe-area-inset-top))]">
      <a href={localePath(locale)} class="icon-button" aria-label={t('nav.home')} title={t('nav.home')}>
        <Fragment set:html={BACK_ICON} />
      </a>
      <span data-hud-level class="shrink-0 font-logo text-xl font-black"></span>
      <div data-hud-bar role="progressbar" aria-label={t('game.progress')} aria-valuemin="0" class="candy-track relative flex-1">
        <div data-hud-fill class="candy-fill"></div>
        <span data-hud-count class="absolute inset-0 grid place-items-center text-[11px] font-extrabold tabular-nums [text-shadow:0_1px_2px_#0009]"></span>
      </div>
      <OptionsButton locale={locale} />
    </header>

    <div data-play class="relative min-h-0 flex-1">
      {/* Hinweis nur, bis zum ersten Mal ein Schiff gestartet wurde (modes/solo.js), dann blendet er aus */}
      <p data-hint class="reveal absolute inset-x-0 top-1 px-6 text-center text-xs text-muted">{t('game.hint')}</p>
      <p data-toast aria-live="polite"
         class="toast absolute inset-x-0 top-12 mx-auto w-fit rounded-full bg-surface/90 px-4 py-2 text-sm font-extrabold shadow-lg"></p>
      <p data-no-webgl hidden class="absolute inset-0 grid place-items-center p-6 text-center text-muted">{t('game.noWebgl')}</p>
    </div>

    <ol data-queue aria-label={t('game.queue')}
        class="relative flex shrink-0 justify-center gap-3 bg-gradient-to-b from-transparent via-surface/55 to-surface/90 px-3 pt-6 pb-[max(0.75rem,env(safe-area-inset-bottom))] [&_button]:pointer-events-auto"></ol>
  </div>

  <dialog data-dialog class="m-auto w-[min(22rem,calc(100%-2rem))] rounded-3xl border-2 border-line bg-surface p-6 text-center text-text">
    <h2 data-dialog-title class="font-logo text-4xl font-black"></h2>
    <p data-dialog-text class="mt-3 text-muted"></p>
    <button type="button" data-dialog-action autofocus
            class="candy mt-6 w-full rounded-2xl px-6 py-3 text-lg font-extrabold"></button>
  </dialog>
</div>

<script>
  import { startSolo } from '../scripts/modes/solo.js';

  const root = document.querySelector<HTMLElement>('[data-solo]')!;
  startSolo(root, root.dataset.locale!);
</script>
