---
// Optionen: Sprache wählen und „Über corepop“ (Bibliotheken, Schrift, Lizenzen). Ein <dialog> pro Seite (Base.astro),
// geöffnet über das Zahnrad (OptionsButton.astro). Während er offen ist, pausiert das Spiel (modes/solo.js).
import { useTranslations, localePath, LANGUAGES } from '../i18n/index.js';
import { RUNTIME, ASSETS, BUILD } from '../data/credits.js';
import { CLOSE_ICON, LOCK_ICON } from '../scripts/ui/icons.js';
import { DESIGNS } from '../scripts/store/progress.js';

interface Props {
  locale: string;
  page: '' | 'play';
}
const { locale, page } = Astro.props;
const t = useTranslations(locale);
const groups = [
  { title: t('about.runtime'), items: RUNTIME },
  { title: t('about.assets'), items: ASSETS },
  { title: t('about.build'), items: BUILD },
];
---

<dialog data-options aria-labelledby="options-title"
        class="m-auto max-h-[min(42rem,calc(100dvh-2rem))] w-[min(28rem,calc(100%-2rem))] overflow-y-auto overscroll-contain rounded-3xl border-2 border-line bg-surface p-0 text-text">
  <div class="sticky top-0 z-10 flex items-center justify-between bg-surface/95 px-5 pt-4 pb-3 backdrop-blur">
    <h2 id="options-title" class="font-logo text-3xl font-black">{t('options.title')}</h2>
    <button type="button" data-options-close class="icon-button" aria-label={t('options.close')} title={t('options.close')}>
      <Fragment set:html={CLOSE_ICON} />
    </button>
  </div>

  <div class="flex flex-col gap-6 px-5 pb-6">
    <section class="flex flex-col gap-3">
      <h3 class="text-sm font-bold uppercase tracking-wide text-muted">{t('options.language')}</h3>
      <ul class="grid grid-cols-2 gap-3">
        {LANGUAGES.map(({ code, name }) => (
          <li>
            <a href={localePath(code, page)} hreflang={code} lang={code} data-lang={code} aria-current={code === locale ? 'true' : undefined}
               class:list={['candy flex items-center justify-center gap-2 rounded-2xl px-4 py-3 font-extrabold', code !== locale && '[--c:#4b5199]']}>
              {name}
              {code === locale && <span aria-hidden="true">✓</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* Flieger-Designs: freigespielt über Sterne (store/progress.js → DESIGNS); Stand nur im Browser (Skript unten) */}
    <section class="flex flex-col gap-3">
      <h3 class="text-sm font-bold uppercase tracking-wide text-muted">{t('design.title')}</h3>
      <ul class="grid grid-cols-2 gap-3">
        {DESIGNS.map(({ id, stars }) => (
          <li>
            <button type="button" data-design={id} data-stars-needed={stars}
                    class="candy flex w-full flex-col items-center justify-center gap-0.5 rounded-2xl px-3 py-2.5 font-extrabold [--c:#4b5199]">
              <span>{t(`design.${id}`)}</span>
              <span data-design-lock hidden class="flex items-center gap-1 text-xs font-bold opacity-80">
                <Fragment set:html={LOCK_ICON} />{t('design.locked', { count: stars })}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-3 leading-relaxed">
      <h3 class="text-sm font-bold uppercase tracking-wide text-muted">{t('about.title')}</h3>
      <p>{t('about.intro')}</p>
      <p class="text-muted">{t('about.privacy')}</p>
      <p class="text-muted">{t('about.openSource')}</p>
      {groups.map(group => (
        <div class="flex flex-col gap-1.5">
          <h4 class="font-bold">{group.title}</h4>
          <ul class="divide-y divide-line overflow-hidden rounded-2xl border-2 border-line text-sm">
            {group.items.map(item => (
              <li class="flex items-baseline gap-3 px-3 py-2.5">
                <span class="flex flex-1 flex-col">
                  <a href={item.url} rel="noopener" target="_blank" class="font-bold text-accent underline-offset-2 hover:underline">{item.name}</a>
                  <span class="text-muted">{t(`about.libs.${item.id}`)}</span>
                </span>
                <span class="whitespace-nowrap text-xs text-muted">{item.license}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</dialog>

<script>
  import { designUnlocked, shipDesign, setShipDesign } from '../scripts/store/progress.js';

  const dialog = document.querySelector<HTMLDialogElement>('[data-options]')!;
  // Flieger-Designs: gesperrte mit Schloss + nötigen Sternen, das gewählte hervorgehoben (gilt ab dem nächsten Level)
  const designButtons = [...dialog.querySelectorAll<HTMLButtonElement>('[data-design]')];
  function showDesigns() {
    const chosen = shipDesign();
    for (const button of designButtons) {
      const id = button.dataset.design!;
      const open = designUnlocked(id);
      button.querySelector<HTMLElement>('[data-design-lock]')!.hidden = open;
      button.setAttribute('aria-disabled', String(!open));
      button.setAttribute('aria-pressed', String(id === chosen));
      button.style.setProperty('--c', id === chosen ? 'var(--color-accent)' : '#4b5199');
    }
  }
  for (const button of designButtons)
    button.addEventListener('click', () => {
      if (button.getAttribute('aria-disabled') === 'true') return;
      setShipDesign(button.dataset.design!);
      showDesigns();
    });
  document.querySelectorAll('[data-options-open]').forEach(button =>
    button.addEventListener('click', () => {
      showDesigns();
      dialog.showModal();
    }),
  );
  dialog.querySelector('[data-options-close]')!.addEventListener('click', () => dialog.close());
  // Klick auf den abgedunkelten Rand schließt (das Ziel ist dann der <dialog> selbst, nicht sein Inhalt)
  dialog.addEventListener('click', e => e.target === dialog && dialog.close());
</script>
